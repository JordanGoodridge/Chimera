/target

# Never commit other games' assets or anything extracted from them.
/extracted/
*.vpk
*.bsp
*.vtf
*.vmt
*.mdl
*.vvd
*.vtx
*.rez
# The asset store's records and manifests (chimera_pack, CHIMERA_VFS_LOG
# logs): they live in the user's cache (~/.cache/chimera/assets), never
# here; these catch one written into a checkout by mistake.
*.zst
/records/
/manifests/
vfs*.log

# Local overrides (e.g. game install paths).
/chimera.local.toml
# Its old name, still read.
/mashup.local.toml

# Agent worktrees (Claude Code), build slots (tools/agent-slot.sh) and
# the post-push test results (tools/post-push-tests.sh).
/.claude/worktrees/
/.claude/slots/
/.claude/post-push/

# Local-only list of private words the pre-push hook refuses (one regex per line).
/.githooks/private-patterns
__pycache__/

# Profiles (docs/performance.md, "See a frame yourself").
trace-*.json
