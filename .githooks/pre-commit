#!/usr/bin/env sh
# Refuse commits while the fast tier of tests fails (unit tests and
# integration tests outside `heavy::`, docs/OBSERVABILITY.md section 1)
# for the packages the staged changes can affect: `repo_checks`' `affected`
# maps the staged files to workspace packages and follows cargo's crate
# graph up to every package whose tests depend on them (checks/src/affected.rs
# has the rules: the workspace manifest, .config/, the hooks or a build.rs
# select everything; the lockfile the crates whose resolved dependencies
# changed; Markdown and docs only the repository checks).
# CHIMERA_COMMIT_TESTS=all runs the whole fast tier; =0 skips it (the old
# name, MASHUP_COMMIT_TESTS, still works).
# The affected heavy tests run before a push (.githooks/pre-push).
# Enable once per clone: git config core.hooksPath .githooks
# Skip in an emergency with: git commit --no-verify
mode=${CHIMERA_COMMIT_TESTS:-${MASHUP_COMMIT_TESTS:-affected}}
[ "$mode" = 0 ] && exit 0
if [ -z "$(git diff --cached --name-only)" ]; then
    exit 0
fi
mkdir -p target
log=target/pre-commit.log
if [ "$mode" = all ]; then
    args=--workspace
    echo "pre-commit: CHIMERA_COMMIT_TESTS=all: the whole fast tier" >&2
elif ! args=$(cargo run --quiet -p repo_checks --bin affected -- --staged --format cargo 2>target/pre-commit-affected.txt); then
    cat target/pre-commit-affected.txt >&2
    echo "pre-commit: couldn't select the affected tests; running the whole fast tier." >&2
    args=--workspace
else
    sed 's/^/pre-commit: /' target/pre-commit-affected.txt >&2
fi
# One argument per line (the selection prints them so).
set -f
IFS='
'
# shellcheck disable=SC2086
set -- $args
unset IFS
if ! cargo test "$@" --features dev --quiet --no-fail-fast -- --skip heavy:: >"$log" 2>&1; then
    grep -E "panicked|FAILED|^error" "$log" | head -20
    echo "pre-commit: fast tests failed (full log: $log); not committing." >&2
    exit 1
fi
