#!/usr/bin/env bash
# Fast pre-commit guard: runs repo_checks (layering, no tracked assets/keys,
# spec rules) in a couple of seconds without compiling Bevy test binaries.
# Enable once per clone: git config core.hooksPath .githooks
# Skip in an emergency: git commit --no-verify
set -euo pipefail

if [ "${CHIMERA_COMMIT_CHECKS:-1}" = "0" ]; then
    exit 0
fi

if [ -z "$(git diff --cached --name-only)" ]; then
    exit 0
fi

cargo test -p repo_checks --quiet
