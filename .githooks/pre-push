#!/usr/bin/env bash
# Pre-push guard: checks for accidentally leaked machine paths or private
# patterns in pushed commits and ensures repo_checks passes.
set -euo pipefail

zero="0000000000000000000000000000000000000000"
bad=0
pushing=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    pushing=1
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi

    patterns='/home/[A-Za-z0-9_.-]+/|/Users/[A-Za-z0-9_.-]+/|[A-Za-z]:\\+Users\\+[A-Za-z0-9_.-]'
    if [ -f .githooks/private-patterns ]; then
        extra=$(grep -v -e '^#' -e '^[[:space:]]*$' .githooks/private-patterns | paste -sd'|' -)
        [ -n "$extra" ] && patterns="$patterns|$extra"
    fi

    hits=$(git log -p --no-color --format='%n%B' "$range" | grep -E -i -n -e "^\+.*($patterns)" -e "^[^-+@ ].*($patterns)" | grep -v '^[0-9]*:+++ ' | head -10 || true)
    if [ -n "$hits" ]; then
        echo "pre-push: personal traces (paths or private patterns) in what's being pushed:" >&2
        echo "$hits" | cut -c1-160 >&2
        bad=1
    fi
done

if [ "$bad" = "1" ]; then
    echo "pre-push: remove personal traces before pushing." >&2
    exit 1
fi

if [ "$pushing" = "1" ]; then
    echo "pre-push: running repo_checks..." >&2
    cargo test -p repo_checks --quiet
fi
