{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/chimera.local.toml)",
      "Read(**/mashup.local.toml)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Edit(**/chimera.local.toml)",
      "Edit(**/mashup.local.toml)",
      "Bash(cat *chimera.local.toml*)",
      "Bash(cat *mashup.local.toml*)",
      "Bash(head *.local.toml*)",
      "Bash(tail *.local.toml*)",
      "Bash(less *.local.toml*)",
      "Bash(grep *chimera.local.toml*)",
      "Bash(sed *chimera.local.toml*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n *)",
      "Bash(git push *--no-verify*)",
      "Bash(git config *user.name *)",
      "Bash(git config *user.email *)",
      "Bash(git push *--force*main*)",
      "Bash(git push *-f *main*)",
      "Bash(git push *+main*)"
    ]
  }
}
